{
  "name": "codex-profile-switcher",
  "displayName": "Codex Sessions & Profiles",
  "description": "底部汇总与切换 Codex 会话，编辑区分析用量和逐轮记录；可选实时状态，保留独立窗口 Profile。",
  "version": "0.9.3",
  "publisher": "huixiangyang",
  "author": "huixiangyang",
  "repository": {
    "type": "git",
    "url": "https://github.com/huixiangyang/codex-profile-switcher.git"
  },
  "homepage": "https://github.com/huixiangyang/codex-profile-switcher#readme",
  "bugs": {
    "url": "https://github.com/huixiangyang/codex-profile-switcher/issues"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "profile",
    "switcher",
    "sessions",
    "multi-project"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexProfiles.switch",
        "title": "切换 Profile",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.create",
        "title": "创建 Profile 草稿",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.preview",
        "title": "预览 Profile 覆盖项",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.open",
        "title": "打开当前配置文件",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.refresh",
        "title": "刷新 Profiles",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.reset",
        "title": "当前窗口恢复默认 Profile",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.disconnect",
        "title": "停用切换器（所有窗口）",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.repairCodex",
        "title": "修复 Codex 已知问题（所有窗口）",
        "category": "Codex Profiles"
      },
      {
        "command": "codexProfiles.restoreCodex",
        "title": "还原 Codex 官方文件（所有窗口）",
        "category": "Codex Profiles"
      },
      {
        "command": "codexSessions.open",
        "title": "打开会话面板",
        "category": "Codex 会话"
      },
      {
        "command": "codexSessions.refresh",
        "title": "刷新会话",
        "category": "Codex 会话"
      },
      {
        "command": "codexSessions.configureLive",
        "title": "配置实时状态监听（当前窗口）",
        "category": "Codex 会话"
      },
      {
        "command": "codexSessions.next",
        "title": "下一条待处理会话",
        "category": "Codex 会话"
      },
      {
        "command": "codexSessions.review",
        "title": "审阅选中会话",
        "category": "Codex 会话"
      },
      {
        "command": "codexSessions.analytics",
        "title": "打开会话分析",
        "category": "Codex 会话"
      }
    ],
    "configuration": {
      "title": "Codex Profiles",
      "properties": {
        "codexProfiles.codexHome": {
          "type": "string",
          "default": "",
          "scope": "window",
          "restricted": true,
          "description": "Codex 配置目录。留空时使用 CODEX_HOME 或 ~/.codex；只支持绝对路径或 ~/ 开头的路径。"
        },
        "codexProfiles.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "在状态栏显示 Codex profile 切换入口。"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "codexSessions",
          "title": "Codex 会话",
          "icon": "resources/sessions.svg"
        }
      ]
    },
    "views": {
      "codexSessions": [
        {
          "id": "codexSessions.list",
          "name": "Codex 会话",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexSessions.open",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/build-tests.mjs && node --test .test-build/*.test.cjs",
    "vscode:prepublish": "npm run check && npm run build",
    "prepackage": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\"",
    "package": "vsce package --no-dependencies --out artifacts/"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.0"
  }
}
